# Copy to .env and fill in. NEVER put real secrets in this file.
# frontend/.env is a symlink to the repo-root .env, so backend + frontend share one file.
# The system runs end-to-end WITHOUT any AI key (deterministic fallbacks for
# explain / rank / classify / report); a key only upgrades the advisory layer.

# --- Database (system of record; shared by the FastAPI backend + Auth.js) ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require&channel_binding=require

# --- AI / advisory layer ----------------------------------------------------
# Provider selection (ADVISORY_PROVIDER): auto | ollama | azure | vertex | openai | anthropic
#   auto      -> local Ollama if it's running with a model pulled, else a hosted
#                key (OpenAI first, then Anthropic)  (default for a fresh clone)
#   ollama    -> always local Ollama
#   openai    -> always OpenAI    (requires OPENAI_API_KEY below)
#   anthropic -> always Anthropic (requires ANTHROPIC_API_KEY below)
#   vertex    -> always Google Vertex AI via Application Default Credentials
#                (VERTEX_* below). Never picked by auto.
ADVISORY_PROVIDER=openai

# Local-first (Ollama). Use ONE model for judge + prose to avoid unloading /
# reloading multi-GB models between calls (which causes cold-start stalls).
OLLAMA_HOST=http://localhost:11434
OLLAMA_JUDGE_MODEL=qwen3-coder:30b
OLLAMA_PROSE_MODEL=qwen3-coder:30b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TIMEOUT=600

# Hosted providers (optional). Under "auto" these are the fallback when no local
# Ollama model is available (OpenAI is tried before Anthropic).
ANTHROPIC_API_KEY=sk-ant-...
ADVISORY_MODEL=claude-sonnet-4-6
OPENAI_API_KEY=sk-...

# Hosting platform: auto | gcp | azure | local. auto detects Cloud Run
# (K_SERVICE) and Container Apps (CONTAINER_APP_NAME); set it on GKE/AKS. On a
# cloud platform, ADVISORY_PROVIDER=auto prefers that platform's own AI service
# (Vertex on GCP, AI Foundry on Azure), then falls back to any BYOK key.
NPR_PLATFORM=auto

# Google Vertex AI (ADVISORY_PROVIDER=vertex). No key: auth is ADC -- the
# service account on Cloud Run, `gcloud auth application-default login` locally.
# VERTEX_PROJECT empty = the project ADC / gcloud config reports.
VERTEX_PROJECT=
VERTEX_LOCATION=global
VERTEX_MODEL=google/gemini-2.5-pro
OPENAI_MODEL=gpt-4o

# --- Backend (FastAPI) ------------------------------------------------------
# Origin allowed to call the API directly (CORS).
FRONTEND_ORIGIN=http://localhost:3000

# --- Frontend (Next.js + Auth.js) -------------------------------------------
AUTH_SECRET=run: openssl rand -base64 32
AUTH_TRUST_HOST=true
# Canonical app origin for magic-link + invite URLs. Leave APP_URL blank to
# auto-derive from the request host (recommended for deploys behind a proxy).
APP_URL=http://localhost:3000
# AUTH_URL=https://your-app.example.com
# Where the Next dev server proxies /api/* (the FastAPI backend).
BACKEND_URL=http://127.0.0.1:8000

# --- AutoX SSO (OIDC) -------------------------------------------------------
# Full setup in docs/SSO.md. Setting SSO_CLIENT_ID turns SSO on AND turns the
# local password / magic-link providers off.
#
# Register in the AutoX admin (https://sso.autogrc.cloud/admin):
#   redirect_uri            <origin>/api/auth/callback/autox
#   post_logout_redirect    <origin>/login
#   app roles               npr_admin | npr_analyst | npr_viewer
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_ISSUER=https://sso.autogrc.cloud
# Audience that makes the access token a JWT carrying autox:app_roles. Sent on
# BOTH /auth and /token — without it on both, the token is opaque and roles are
# unreadable.
SSO_RESOURCE=https://sso.autogrc.cloud/api
SSO_SCOPE="openid profile email orgs roles"
# Absolute session lifetime (seconds) = how quickly an AutoX role grant or
# revocation takes effect, since roles only change in a newly minted token.
SSO_SESSION_MAX_AGE=3600
# Defaults to <origin>/login; must be registered in the SSO byte-for-byte.
SSO_POST_LOGOUT_REDIRECT_URI=
# Optional: remap SSO app-role names without a code change, e.g.
# SSO_ROLE_MAP={"npr-platform-owner":"admin","npr-read":"viewer"}
SSO_ROLE_MAP=
# Keep the legacy password / magic-link login alive alongside SSO ("true"/unset).
AUTH_LOCAL_LOGIN=

# --- Email (Resend; optional) -----------------------------------------------
# Legacy local-login only (unused once SSO is on). Without these, password login
# still works and magic / reset links print to the server console.
RESEND_API_KEY=re_...
EMAIL_FROM="Network Policy Reviewer <npr@autogrc.cloud>"

# --- Admin bootstrap --------------------------------------------------------
# First admin created by: node frontend/scripts/create-admin.mjs
ADMIN_EMAIL=you@example.com

# --- Firewall Rule Review (FRR) --------------------------------------------
# Full list and production values: docs/frr/DEPLOY-GCP.md, docs/frr/DEPLOY-AZURE.md.
# Removes auto-approval and device push from the older change gate; set in every FRR deployment.
NPR_FRR_MODE=1
# Run a job worker inside the API (default: on in dev, off in production, where the
# worker is its own service: python -m src.jobs.worker).
# NPR_JOBS_INLINE=1
# Where uploads and review artifacts go: file:///path (dev), gs://bucket, az://account/container.
# NPR_STORAGE_URL=file:///tmp/npr-store
# Size limits: grants per export (memory), synchronous package drafting (API process).
# NPR_MAX_GRANTS=450000
# NPR_SYNC_DRAFT_MAX_RULES=20000

# --- Break-glass sign-in (local development without an identity provider) ----
# docs/BREAKGLASS.md. Never in production; prefer BREAKGLASS_PASSWORD_HASH. Also set
# AUTH_LOCAL_LOGIN=true above.
# BREAKGLASS_EMAIL=you@example.com
# BREAKGLASS_PASSWORD=
